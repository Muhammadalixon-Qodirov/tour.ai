# setup.sh birinchi ishga tushganda bu faylni avtomatik yaratadi (tasodifiy sirlar bilan).
SERVER_IP=185.174.254.135
DOMAIN=185-174-254-135.sslip.io
DB_PASSWORD=
TOKEN_SECRET=
API_PORT=8130
# 80/443 bo'sh serverda Caddy ishlatish uchun: COMPOSE_PROFILES=caddy
COMPOSE_PROFILES=
CORS_ORIGINS=
# Sayt manzili (story havolasi, chegirma kodi QR, yo'naltirishlar). Standart: https://safar.e-investment.uz
WEB_BASE_URL=https://safar.e-investment.uz
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
# --- Kirish (auth) ---
# Google OAuth client ID lar (web, android, ios) vergul bilan. Client secret KERAK EMAS.
GOOGLE_CLIENT_IDS=
# Email kodlari uchun SMTP (587 STARTTLS yoki 465 TLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Safar <noreply@e-investment.uz>
# Xatlarda ko'rinadigan brend nomi
APP_NAME=Safar
# --- Joy topish ---
# Wikidata dan yangi joylar har shuncha vaqtda (bo'sh — o'chiq). OSM: osm-refresh.sh (cron, haftalik)
DISCOVERY_EVERY=24h
# --- AI ma'lumot tozalovchi ---
# Ichki tarmoqdagi AI server (cleaner ishchisi) uchun kalit. Bo'sh — /internal/clean/* o'chiq.
# Kuchli tasodifiy qiymat: openssl rand -hex 24
CLEANER_KEY=
# --- Telegram crowdsourcing boti ---
# @BotFather dan olingan token; COMPOSE_PROFILES ga tgbot qo'shing.
TELEGRAM_BOT_TOKEN=
# Bot va /internal/suggest uchun umumiy kalit: openssl rand -hex 24
BOT_KEY=
# --- AI yordamchi (POST /api/v1/guide/chat) ---
# Bo'sh bo'lsa yordamchi bazadan qidiruv bilan javob beradi (AI siz). Kalit: console.anthropic.com
ANTHROPIC_API_KEY=
# Anthropic kaliti bo'lmasa Groq ishlatiladi (model: openai/gpt-oss-120b). Kalit: console.groq.com
# Bir nechta kalit vergul bilan — biri limitga urilsa keyingisiga o'tadi: GROQ_API_KEY=gsk_aaa,gsk_bbb
GROQ_API_KEY=
# Standart: claude-opus-5-5. Arzonroq/tezroq: claude-sonnet-5-5 yoki claude-haiku-5-5
AI_MODEL=
# --- Adolatli narx (Lens) ---
# Rasm tanish modeli (Groq). Bo'sh — qwen/qwen3.8-27b
LENS_VISION_MODEL=
# Market qidiruvi uchun HTTP proksi. OLX, Asaxiy, Olcha xorijiy datacenter IP larini bloklaydi; qidiruvni
# O'zbekistondagi o'z serveringiz orqali yuborish uchun: MARKET_PROXY=http://<uz-server>:3128
MARKET_PROXY=
# O'zbekistondagi server orqali SSH SOCKS proksi (market-proxy xizmati): COMPOSE_PROFILES=marketproxy bilan
#   MARKET_PROXY=socks5://market-proxy:1080
#   MARKET_PROXY_SSH=user@uz-server-ip   MARKET_PROXY_SSH_PORT=22
MARKET_PROXY_SSH=
MARKET_PROXY_SSH_PORT=
# Marketlarni curl bilan oladigan yordamchi (OLX/Uzum uchun; market-proxy bilan birga):
MARKET_FETCH_URL=http://market-fetch:8890
# Uzum (eng katta market) anonim Bearer token — brauzerda uzum.uz da qidirib, DevTools > Network > graphql.uzum.uz
# so'rovidagi Authorization qiymati (Bearer ...). ~12 soatda eskiradi. Bo'sh — Uzum o'chiq.
UZUM_BEARER=
# --- Ovozdan matn (STT) ---
# Serverdagi o'zbekcha Kotib modeli (stt-relay, COMPOSE_PROFILES ga sttrelay qo'shing). Bo'sh — faqat Groq Whisper.
STT_RELAY_SOCKET=
# Serverning o'zidagi Kotib (COMPOSE_PROFILES ga sttkotib): STT_KOTIB_URL=http://stt-kotib:8000
STT_KOTIB_URL=
