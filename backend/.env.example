# Nusxa oling: cp .env.example .env
DATABASE_URL=postgres://yoldosh@localhost:5433/yoldosh?sslmode=disable
TEST_DATABASE_URL=postgres://yoldosh@localhost:5433/yoldosh_test?sslmode=disable
# kamida 32 belgi; productionda tasodifiy qiymat: openssl rand -base64 48
TOKEN_SECRET=change-me-change-me-change-me-change-me
ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
# admin web panel domenlari, vergul bilan
CORS_ORIGINS=http://localhost:5173
# yuklangan rasmlar papkasi
UPLOAD_DIR=data/uploads
# AI xizmati (7-bosqich). Bo'sh bo'lsa marshrut shablon matnlar bilan ishlaydi.
AI_BASE_URL=
AI_INTERNAL_KEY=
# Kechki "hikoyangiz tayyor" push eslatmalari (Expo). true bo'lsa yoqiladi.
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
# --- Kirish (auth) ---
# Google OAuth client ID lar (web, android, ios) vergul bilan. Client secret KERAK EMAS.
GOOGLE_CLIENT_IDS=
# Email kodlari uchun SMTP (587 STARTTLS yoki 465 TLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Yo'ldosh AI <noreply@e-investment.uz>
# Faqat lokal: xat yuborilmaydi, kod logga yoziladi
MAIL_DEV_LOG=true
